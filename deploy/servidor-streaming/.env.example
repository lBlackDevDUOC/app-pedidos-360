# Plantilla del .env del servidor de streaming. En la EC2 lo escribe GitHub Actions desde los secrets:
#   KAFKA_PRIVATE_IP  → KAFKA_ADVERTISED_HOST
#   KAFKA_UI_USER / KAFKA_UI_PASSWORD
# En local no hace falta: los valores por defecto anuncian los brokers como localhost.
KAFKA_ADVERTISED_HOST=localhost
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=cambiar-esta-clave
